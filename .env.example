# Copy to .env and fill in your own credentials locally.
# Environment variables take precedence over .env values.
DEEPSEEK_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT=90

# IMA credentials and the full name of a knowledge base you can access.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=请填写已加入的知识库完整名称
IMA_SKILL_PATH=vendor/ima-skill/ima_api.cjs

# Optional topic search. Public search may be unavailable or rate limited.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
